# =============================================================================
# Atenti - Variables de entorno
# Copiá este archivo como `.env` y completá los valores reales.
# Las variables con prefijo EXPO_PUBLIC_ se exponen al cliente en build time.
# NUNCA commitees el archivo .env con valores reales.
# =============================================================================

# --- Firebase (Authentication, Firestore, Storage) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google Maps / Geocoding ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Google Sign-In (webClientId del OAuth 2.0 de Firebase) ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Cloud Functions (OCR, rate limiting, spam) ---
EXPO_PUBLIC_CLOUD_FUNCTIONS_BASE_URL=
# Región donde desplegaste las functions (por defecto us-central1)
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# --- RENAPER (verificación de DNI) ---
# Dejar enabled=false hasta contar con credenciales; el DNI queda "verificando".
EXPO_PUBLIC_RENAPER_ENABLED=false
EXPO_PUBLIC_RENAPER_ENDPOINT=
EXPO_PUBLIC_RENAPER_API_KEY=

# --- Rate limiting (RF-090): denuncias por usuario por día ---
EXPO_PUBLIC_RATE_LIMIT_DAILY=10

# --- Administración: emails autorizados separados por coma (RF-015 pendiente) ---
EXPO_PUBLIC_ADMIN_EMAILS=

# --- Observabilidad (opcional): DSN de Sentry ---
EXPO_PUBLIC_SENTRY_DSN=
