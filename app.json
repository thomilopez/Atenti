{
  "expo": {
    "name": "Atenti",
    "slug": "atenti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atenti.app",
      "config": {
        "googleMapsApiKey": "AIzaSyA-t6THjJGoF4rGvwHuMLzUn7bLCmM8RRI"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Atenti necesita tu ubicación para reportar y visualizar alertas de fraudes cercanos.",
        "NSPhotoLibraryUsageDescription": "Permite adjuntar capturas y comprobantes como evidencia del reporte.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "atenti.android",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA-t6THjJGoF4rGvwHuMLzUn7bLCmM8RRI"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9df2fa5e-9519-4896-be9c-68243f75f71b"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-sharing"
    ],
    "owner": "atenti"
  }
}
